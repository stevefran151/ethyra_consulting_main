# Google SMTP Configuration for Ethyra Consulting Website
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password under "Security" -> "2-Step Verification" -> "App passwords":
#    Select App name (e.g. "Ethyra Website") and copy the 16-character generated password.
# 3. Paste your Gmail address and 16-character App Password below (spaces are automatically stripped):

GMAIL_USER=
GMAIL_APP_PASS=

# Optional server port (defaults to 3000)
PORT=3000

# Recipient email address for topic suggestions (defaults to GMAIL_USER if not set)
SUGGESTION_RECIPIENT_EMAIL=your-recipient-email@organisation.org
